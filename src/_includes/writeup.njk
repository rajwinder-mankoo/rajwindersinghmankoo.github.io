<!DOCTYPE html><html lang="en"><head>{% include "head.njk" %}</head><body>
{% include "nav.njk" %}
<main id="main" class="shell article-page">
  <header class="article-header"><a class="text-link" href="/#writeups">← All writeups</a><p class="eyebrow">Lab journal · {{ date | readableDate }}</p><h1>{{ title }}</h1><p class="article-summary">{{ summary }}</p></header>
  <div class="article-grid"><aside class="article-aside" hidden><p class="mono">In this writeup</p><nav id="article-toc" aria-label="Table of contents"></nav><a class="text-link" href="/#labs">Back to the lab ↗</a></aside><article class="writeup-body">{{ content | safe }}</article></div>
  <div class="article-end"><p>More from c0mpl1cated.labs</p><a class="text-link" href="{{ site.instagram }}">Follow the lab journal ↗</a></div>
</main>{% include "footer.njk" %}</body></html>
