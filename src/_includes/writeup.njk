<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="{{ summary or site.metaDescription }}" />
<meta name="author" content="{{ site.name }}" />
<link rel="canonical" href="https://rajwindersinghmankoo.dev{{ page.url }}" />
<title>{{ title }} | {{ site.name }}</title>

<!-- Open Graph / Twitter -->
<meta property="og:type" content="article" />
<meta property="og:title" content="{{ title }} | {{ site.name }}" />
<meta property="og:description" content="{{ summary or site.metaDescription }}" />
<meta property="og:url" content="https://rajwindersinghmankoo.dev{{ page.url }}" />
<meta property="og:image" content="https://rajwindersinghmankoo.dev/assets/favicon.png" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="{{ title }} | {{ site.name }}" />
<meta name="twitter:description" content="{{ summary or site.metaDescription }}" />
<meta name="twitter:image" content="https://rajwindersinghmankoo.dev/assets/favicon.png" />

<link rel="icon" type="image/png" href="/assets/favicon.png" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

<link rel="stylesheet" href="/style.css" />
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<nav id="navbar" role="navigation" aria-label="Main navigation">
  <div class="container nav-inner">
    <a href="/#hero" class="nav-logo" aria-label="Home">RSM<span>_</span></a>
    <ul class="nav-links" id="navLinks" role="list">
      <li><a href="/#about">About</a></li>
      <li><a href="/#labs">Labs</a></li>
      <li><a href="/#writeups">Writeups</a></li>
      <li><a href="/#certs">Certs</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<main id="main">
  <section class="section" style="padding-top: 140px;">
    <div class="container" style="max-width: 800px;">
      <p class="exp-meta"><a href="/#writeups" class="project-link">← Back to writeups</a></p>
      <h1 class="section-title">{{ title }}</h1>
      <p class="section-subtitle">{{ date.toDateString() }}</p>
      <div class="writeup-body reveal">
        {{ content | safe }}
      </div>
    </div>
  </section>
</main>

<footer role="contentinfo">
  <div class="container footer-inner">
    <p>&copy; <span id="year">2026</span> <span>{{ site.name }}</span> · Built with Eleventy</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/#hero">Home</a>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="{{ site.youtube }}" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer">X</a>
    </nav>
  </div>
</footer>

<script src="/script.js"></script>
<script>document.getElementById('year').textContent = new Date().getFullYear();</script>
</body>
</html>
