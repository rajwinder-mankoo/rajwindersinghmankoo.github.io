<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="{{ site.metaDescription }}" />
<meta name="author" content="{{ site.name }}" />
<title>{{ site.pageTitle }}</title>

<!-- Favicon -->
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<link rel="stylesheet" href="/style.css" />
</head>
<body>

<!-- ══════════════════════════════════════════════
     NAVBAR
     ══════════════════════════════════════════════ -->
<nav id="navbar" role="navigation" aria-label="Main navigation">
  <div class="container nav-inner">
    <a href="#hero" class="nav-logo" aria-label="Home">RSM<span>_</span></a>

    <ul class="nav-links" id="navLinks" role="list">
      <li><a href="#about">About</a></li>
      <li><a href="#experience">Experience</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#labs">Labs</a></li>
      <li><a href="#writeups">Writeups</a></li>
      <li><a href="#certs">Certs</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<main>

<!-- ══════════════════════════════════════════════
     HERO
     ══════════════════════════════════════════════ -->
<section id="hero" aria-label="Introduction">
  <div class="container hero-content">
    <div class="hero-tag">{{ site.heroTag }}</div>
    <h1 class="hero-name">
      Rajwinder<br />
      <span class="accent">Singh Mankoo</span>
    </h1>

    <p class="hero-tagline" aria-live="polite">
      <span id="typewriter" data-phrases='{{ site.typewriterPhrases | dump | safe }}'></span><span class="cursor" aria-hidden="true"></span>
    </p>

    <p class="hero-intro">{{ site.heroIntro }}</p>

    <div class="hero-btns">
      <a href="#labs" class="btn btn-primary">View Labs</a>
      <a href="#contact" class="btn btn-outline">Contact</a>
    </div>
  </div>
  <div class="hero-orb" aria-hidden="true"></div>
</section>

<!-- ══════════════════════════════════════════════
     ABOUT
     ══════════════════════════════════════════════ -->
<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <h2 class="section-title" id="about-title">about_me</h2>
    <p class="section-subtitle">A little about who I am and what drives me.</p>

    <div class="about-grid">
      <div class="about-text reveal">
        <p>
          I'm a <strong>cybersecurity student at Southern Utah University</strong>,
          minoring in Computer Science, with hands-on experience across security
          fundamentals, IT operations, and web development. I'm currently working
          as an <strong>Admissions Processing Assistant</strong>, supporting the
          full admissions lifecycle and engaging with prospective graduate and
          online students.
        </p>
        <p>
          I'm building <strong>c0mpl1cated.labs</strong> — a six-project enterprise
          homelab series covering infrastructure, SIEM deployment, detection
          engineering, DFIR, and AI-assisted analysis — while practising
          purple-team methodology and competing in CTFs.
        </p>
        <p>
          I'm also a <strong>co-author of a published research chapter</strong> on
          privacy-preserving quantum computing, and I've contributed to community
          outreach and STEM initiatives through my work with Southern Utah University's
          OutreachMAD programme.
        </p>
        <p>
          My long-term goal is to work as a <strong>detection engineer or purple
          team operator</strong> — using offensive security fundamentals to build
          better defenses, not just to break things.
        </p>

        <div class="about-interests">
          <h4>// INTERESTS</h4>
          <div class="tag-list">
            <span class="tag">Detection Engineering</span>
            <span class="tag">Purple Teaming</span>
            <span class="tag">Homelabs</span>
            <span class="tag">CTF Competitions</span>
            <span class="tag">SIEM &amp; Log Analysis</span>
            <span class="tag">Active Directory</span>
            <span class="tag">OSINT</span>
            <span class="tag">Research</span>
          </div>
        </div>
      </div>

      <div class="terminal reveal" role="img" aria-label="Terminal showing profile details">
        <div class="terminal-bar">
          <span class="dot red" aria-hidden="true"></span>
          <span class="dot yellow" aria-hidden="true"></span>
          <span class="dot green" aria-hidden="true"></span>
        </div>
        <div class="terminal-body">
          <div><span class="prompt">$ </span><span class="cmd">whoami</span></div>
          <div class="output">rajwinder-mankoo</div>
          <br />
          <div><span class="prompt">$ </span><span class="cmd">cat profile.txt</span></div>
          <div class="output"><span class="hl">University :</span> Southern Utah University</div>
          <div class="output"><span class="hl">Major :</span> Cybersecurity (Minor: CS)</div>
          <div class="output"><span class="hl">Focus :</span> Detection Engineering / Purple Team</div>
          <br />
          <div><span class="prompt">$ </span><span class="cmd">cat goal.txt</span></div>
          <div class="output">{{ site.goalStatement }}</div>
          <br />
          <div><span class="prompt">$ </span><span class="cmd">_</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     EXPERIENCE
     ══════════════════════════════════════════════ -->
<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container">
    <h2 class="section-title" id="experience-title">experience</h2>
    <p class="section-subtitle">Roles and positions I've held.</p>

    <div class="projects-grid">
      <article class="project-card reveal">
        <div class="project-top">
          <span class="project-icon" aria-hidden="true">🎓</span>
          <h3>Admissions Processing Assistant</h3>
        </div>
        <p class="exp-meta">Southern Utah University · Part-time &nbsp;|&nbsp; Dec 2025 – Present · Cedar City, UT</p>
        <p>
          Support the full admissions lifecycle for prospective graduate and online
          students within SUU's Enrollment Management Department. Process application
          materials, conduct outbound outreach, and maintain student records using
          Banner, CRM Slate, Google Workspace, and Slack.
        </p>
        <div class="project-tags">
          <span class="project-tag">CRM Slate</span>
          <span class="project-tag">Banner</span>
          <span class="project-tag">Customer Service</span>
          <span class="project-tag">Data Management</span>
        </div>
      </article>

      <article class="project-card reveal">
        <div class="project-top">
          <span class="project-icon" aria-hidden="true">📡</span>
          <h3>Ambassador — OutreachMAD 2.0</h3>
        </div>
        <p class="exp-meta">Southern Utah University · Part-time &nbsp;|&nbsp; Dec 2023 – Mar 2025 · Cedar City, UT</p>
        <p>
          Participated in the Utah STEM Action Center's women-in-tech programme,
          delivering hands-on outreach activities for high school girls, analysing
          project data, updating websites, and presenting outcomes at conferences.
        </p>
        <div class="project-tags">
          <span class="project-tag">STEM Outreach</span>
          <span class="project-tag">Web Development</span>
          <span class="project-tag">Data Analysis</span>
          <span class="project-tag">Community Outreach</span>
        </div>
      </article>

      <article class="project-card reveal">
        <div class="project-top">
          <span class="project-icon" aria-hidden="true">🌐</span>
          <h3>Junior Web Developer</h3>
        </div>
        <p class="exp-meta">Phoenix Art · Internship &nbsp;|&nbsp; Feb 2023 – Jul 2023 · Ludhiana, PB</p>
        <p>
          Internship focused on front-end web development, building and maintaining
          web pages and applying problem-solving skills in a professional studio
          environment.
        </p>
        <div class="project-tags">
          <span class="project-tag">HTML</span>
          <span class="project-tag">Web Development</span>
          <span class="project-tag">Problem Solving</span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SKILLS
     ══════════════════════════════════════════════ -->
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <h2 class="section-title" id="skills-title">skills</h2>
    <p class="section-subtitle">Tools and technologies I work with.</p>

    <div class="skills-grid">
      <article class="skill-card reveal">
        <div class="skill-card-icon" aria-hidden="true">🛡️</div>
        <h3>DETECTION &amp; SIEM</h3>
        <ul class="skill-list">
          <li>Wazuh</li>
          <li>Sigma Rules</li>
          <li>MITRE ATT&amp;CK</li>
          <li>Log Analysis</li>
          <li>Threat Hunting</li>
          <li>Splunk</li>
        </ul>
      </article>

      <article class="skill-card reveal">
        <div class="skill-card-icon" aria-hidden="true">⚔️</div>
        <h3>OFFENSIVE SECURITY</h3>
        <ul class="skill-list">
          <li>Nmap</li>
          <li>Metasploit</li>
          <li>Burp Suite</li>
          <li>BloodHound</li>
          <li>Mimikatz</li>
          <li>Responder</li>
        </ul>
      </article>

      <article class="skill-card reveal">
        <div class="skill-card-icon" aria-hidden="true">🌐</div>
        <h3>NETWORKING</h3>
        <ul class="skill-list">
          <li>TCP/IP</li>
          <li>Active Directory</li>
          <li>DNS / DHCP</li>
          <li>VLANs</li>
          <li>Firewall Rules</li>
          <li>Wireshark</li>
        </ul>
      </article>

      <article class="skill-card reveal">
        <div class="skill-card-icon" aria-hidden="true">💻</div>
        <h3>PROGRAMMING</h3>
        <ul class="skill-list">
          <li>Python</li>
          <li>C / C++</li>
          <li>Go</li>
          <li>Java</li>
          <li>Bash</li>
          <li>PowerShell</li>
        </ul>
      </article>

      <article class="skill-card reveal">
        <div class="skill-card-icon" aria-hidden="true">🔧</div>
        <h3>TOOLS &amp; PLATFORMS</h3>
        <ul class="skill-list">
          <li>Ghidra</li>
          <li>Linux / Kali</li>
          <li>Proxmox</li>
          <li>Windows Server</li>
          <li>Docker</li>
          <li>Git</li>
        </ul>
      </article>

      <article class="skill-card reveal">
        <div class="skill-card-icon" aria-hidden="true">🖥️</div>
        <h3>IT &amp; SYSTEMS ADMIN</h3>
        <ul class="skill-list">
          <li>Systems Administration</li>
          <li>Technical Support</li>
          <li>Microsoft Windows</li>
          <li>Network Troubleshooting</li>
          <li>IT Infrastructure</li>
          <li>CRM Software</li>
        </ul>
      </article>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     LABS (c0mpl1cated.labs roadmap — data-driven)
     ══════════════════════════════════════════════ -->
<section id="labs" class="section" aria-labelledby="labs-title">
  <div class="container">
    <h2 class="section-title" id="labs-title">c0mpl1cated.labs</h2>
    <p class="section-subtitle">A six-project enterprise homelab series — infrastructure, SIEM, detection engineering, DFIR, and AI-assisted SOC.</p>

    <div class="projects-grid">
      {% for lab in labs %}
      <article class="project-card reveal">
        <div class="project-top">
          <span class="project-icon" aria-hidden="true">{{ lab.icon }}</span>
          <h3>{{ lab.name }}</h3>
        </div>
        <span class="status-badge {{ lab.statusClass }}">{{ lab.status }}</span>
        <p>{{ lab.description }}</p>
        <div class="project-tags">
          {% for tag in lab.tags %}
          <span class="project-tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% if lab.repo %}
        <a href="{{ lab.repo }}" class="project-link" target="_blank" rel="noopener noreferrer">View repo →</a>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     WRITEUPS / BLOG (data-driven, falls back to placeholder)
     ══════════════════════════════════════════════ -->
<section id="writeups" class="section" aria-labelledby="writeups-title">
  <div class="container">
    <h2 class="section-title" id="writeups-title">writeups</h2>
    <p class="section-subtitle">Cybersecurity writeups and walkthroughs.</p>

    {% if collections.writeups.length %}
    <div class="projects-grid">
      {% for post in collections.writeups %}
      <article class="project-card reveal">
        <div class="project-top">
          <span class="project-icon" aria-hidden="true">📝</span>
          <h3>{{ post.data.title }}</h3>
        </div>
        <p class="exp-meta">{{ post.date.toDateString() }}</p>
        <p>{{ post.data.summary }}</p>
        <a href="{{ post.url }}" class="project-link">Read more →</a>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="writeups-placeholder reveal">
      <div class="ph-icon" aria-hidden="true">📝</div>
      <h3>Writeups &amp; Walkthroughs</h3>
      <p>
        CTF solutions, TryHackMe room walkthroughs, homelab write-ups,
        and research notes will be published here. Check back soon or
        follow me on GitHub for updates.
      </p>
      <a href="{{ site.github }}" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        Follow on GitHub
      </a>
    </div>
    {% endif %}
  </div>
</section>

<!-- ══════════════════════════════════════════════
     CERTIFICATIONS & ACHIEVEMENTS
     ══════════════════════════════════════════════ -->
<section id="certs" class="section" aria-labelledby="certs-title">
  <div class="container">
    <h2 class="section-title" id="certs-title">certs_&amp;_achievements</h2>
    <p class="section-subtitle">Credentials and competition results.</p>

    <div class="certs-grid">
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">🎖️</div>
        <div class="cert-info">
          <h3>CRTA</h3>
          <div class="cert-detail">Certified Red Team Analyst</div>
          <div class="cert-org">CyberWarFare Labs &nbsp;·&nbsp; Mar 2026</div>
        </div>
      </article>
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">🛡️</div>
        <div class="cert-info">
          <h3>CSEDP</h3>
          <div class="cert-detail">Certified Social Engineering Defense Practitioner</div>
          <div class="cert-org">The SecOps Group &nbsp;·&nbsp; Feb 2026</div>
        </div>
      </article>
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">🖥️</div>
        <div class="cert-info">
          <h3>Google IT Support Professional</h3>
          <div class="cert-detail">5-course specialisation</div>
          <div class="cert-org">Google / Coursera &nbsp;·&nbsp; Feb 2026</div>
        </div>
      </article>
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">🏅</div>
        <div class="cert-info">
          <h3>CNSP</h3>
          <div class="cert-detail">Certified Network Security Practitioner</div>
          <div class="cert-org">The SecOps Group &nbsp;·&nbsp; Dec 2025</div>
        </div>
      </article>
      <!-- TODO: ISC2 CC (Certified in Cybersecurity) — in the project charter but no
           completion date confirmed yet. Add here once confirmed. Carried over from
           ADR-WEB-001's original open item, not resolved by this rebuild. -->
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">⚡</div>
        <div class="cert-info">
          <h3>TryHackMe</h3>
          <div class="cert-detail">Top 4% &nbsp;·&nbsp; Intro to Cyber Security</div>
          <div class="cert-org">TryHackMe Platform &nbsp;·&nbsp; Apr 2024</div>
        </div>
      </article>
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">🐍</div>
        <div class="cert-info">
          <h3>Python (Basic)</h3>
          <div class="cert-detail">Certified</div>
          <div class="cert-org">HackerRank &nbsp;·&nbsp; Feb 2022</div>
        </div>
      </article>
      <article class="cert-card reveal">
        <div class="cert-badge" aria-hidden="true">🥇</div>
        <div class="cert-info">
