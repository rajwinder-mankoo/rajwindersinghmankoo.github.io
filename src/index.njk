      </article>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     CONTACT
     ══════════════════════════════════════════════ -->
<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="section-title" id="contact-title">contact</h2>
    <p class="section-subtitle">Get in touch — I'm open to opportunities and collaboration.</p>

    <div class="contact-text reveal">
      <h3>Let's connect.</h3>
      <p>
        Whether you want to talk about cybersecurity, collaborate on a
        project, or discuss opportunities — feel free to reach out.
      </p>
      <address class="contact-links" style="font-style:normal;">
        <a href="mailto:{{ site.email }}" class="contact-link">
          <span class="icon" aria-hidden="true">✉️</span>{{ site.email }}
        </a>
        <a href="{{ site.github }}" class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="icon" aria-hidden="true">🐙</span>github.com/rajwinder-mankoo
        </a>
        <a href="{{ site.linkedin }}" class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="icon" aria-hidden="true">💼</span>linkedin.com/in/rajwinder-mankoo
        </a>
        <a href="{{ site.youtube }}" class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="icon" aria-hidden="true">▶️</span>youtube.com/@c0mpl1catedlabs
        </a>
        <a href="{{ site.instagram }}" class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="icon" aria-hidden="true">📸</span>instagram.com/c0mpl1cated.labs
        </a>
        <a href="{{ site.twitter }}" class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="icon" aria-hidden="true">𝕏</span>x.com/c0mpl1catedlabs
        </a>
      </address>
    </div>
  </div>
</section>

</main>

<!-- ══════════════════════════════════════════════
     FOOTER
     ══════════════════════════════════════════════ -->
<footer role="contentinfo">
  <div class="container footer-inner">
    <p>&copy; <span id="year">2026</span> <span>{{ site.name }}</span> — Built with Eleventy</p>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="#hero">Home</a>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="{{ site.youtube }}" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="{{ site.twitter }}" target="_blank" rel="noopener noreferrer">X</a>
    </nav>
  </div>
</footer>

<script src="/script.js"></script>
<script>document.getElementById('year').textContent = new Date().getFullYear();</script>
</body>
</html>
